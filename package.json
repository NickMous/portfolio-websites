{
  "name": "portfolio-websites",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "sites/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:sanderdh": "npm run dev -w @portfolio/sanderdh",
    "build:sanderdh": "npm run build -w @portfolio/sanderdh",
    "check": "npm run check --workspaces --if-present",
    "dev:playground": "npm run dev -w @portfolio/playground",
    "dev:webenjoyer": "npm run dev -w @portfolio/webenjoyer",
    "build:webenjoyer": "npm run build -w @portfolio/webenjoyer",
    "dev:imlostincode": "npm run dev -w @portfolio/imlostincode",
    "build:imlostincode": "npm run build -w @portfolio/imlostincode",
    "dev:nickmous": "npm run dev -w @portfolio/nickmous",
    "build:nickmous": "npm run build -w @portfolio/nickmous"
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
