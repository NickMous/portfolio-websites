---
import HeroHeadline from '@portfolio/ui-kit/components/HeroHeadline.astro';
import BaseLayout from '@portfolio/ui-kit/layouts/BaseLayout.astro';
import { t } from '../i18n';

// Placeholder shell proving the workspace wiring; the real hub is #16.
const hub = t('hub');
---

<BaseLayout site="sanderdh" title="Sander den Hollander" description={hub('description')}>
  <div class="container-page py-16">
    <HeroHeadline
      lines={[
        { text: hub('greeting') },
        { text: 'Sander', block: 'green' },
        { text: 'den Hollander.' },
      ]}
    />
  </div>
</BaseLayout>
