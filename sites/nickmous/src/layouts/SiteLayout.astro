---
import SiteFooter from '@portfolio/ui-kit/components/SiteFooter.astro';
import BaseLayout from '@portfolio/ui-kit/layouts/BaseLayout.astro';
import EasterEgg from '../easterEgg/EasterEgg.astro';
import { t } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** The 404 page (see BaseLayout). */
  notFound?: boolean;
}

const meta = t('meta');
const nav = t('nav');
const footer = t('footer');
const {
  title = meta('title'),
  description = meta('description'),
  ogImage,
  notFound = false,
} = Astro.props;

// Section anchors live on the homepage; from other pages they lead back there.
const home = Astro.url.pathname === '/' ? '' : '/';
const links = [
  { href: `${home}#games`, label: nav('games') },
  { href: `${home}#projects`, label: nav('projects') },
  { href: `${home}#about`, label: nav('about') },
  { href: `${home}#guestbook`, label: nav('guestbook') },
];
---

<BaseLayout
  site="nickmous"
  {title}
  {description}
  {...(ogImage ? { ogImage } : {})}
  nav={links}
  {notFound}
>
  <slot />
  <EasterEgg />
  <SiteFooter site="nickmous" slot="footer">
    <span slot="note">{footer('secret')}</span>
  </SiteFooter>
</BaseLayout>
