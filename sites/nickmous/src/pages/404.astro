---
import NotFound from '@portfolio/ui-kit/components/NotFound.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { t } from '../i18n';

const nf = t('notFound');
---

<SiteLayout title={nf('title')} description={nf('text')} notFound>
  <NotFound
    lines={[{ text: nf('line1') }, { text: nf('line2'), block: 'blue', tilt: 'right' }]}
    text={nf('text')}
    link={{ href: '/', label: nf('back') }}
  />
</SiteLayout>
