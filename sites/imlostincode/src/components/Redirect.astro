---
import { t } from '../i18n';

interface Props {
  to: string;
}

// Static hosting has no server redirects, so this page forwards in the browser.
const { to } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${to}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={to} />
    <title>{t('docs')('redirecting')} {to}</title>
  </head>
  <body>
    <a href={to}>
      {t('docs')('redirecting')} {to}
    </a>
  </body>
</html>
