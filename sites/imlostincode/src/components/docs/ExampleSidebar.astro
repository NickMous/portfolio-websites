---
import type { ExampleGroup } from '../../docs/nav';

interface Props {
  label: string;
  groups: ExampleGroup<{ slug: string }>[];
  href: (slug: string) => string;
  /** Slug of the file being shown. */
  current?: string;
}

const { label, groups, href, current } = Astro.props;
---

<aside
  aria-label={label}
  class="flex max-w-[280px] min-w-0 flex-[1_1_240px] flex-col border-3 border-ink bg-white max-sm:max-w-none max-sm:flex-none sm:sticky sm:top-6 sm:max-h-[calc(100vh-3rem)] sm:overflow-y-auto"
>
  <span class="border-b-3 border-ink px-4 py-3.5 type-label">{label}</span>
  <ul>
    {groups.map((group) => (
      <li class="border-b-2 border-ink last:border-b-0">
        {group.folder && (
          <span
            class="block bg-grey-tint px-4 pt-3 pb-2 font-mono text-[14px] font-bold [overflow-wrap:anywhere]"
            style={`padding-left: ${16 + group.depth * 14}px`}
          >
            {group.name}/
          </span>
        )}
        {group.files.length > 0 && (
          <ul>
            {group.files.map((file) => (
              <li class="border-t-2 border-dashed border-ink first:border-t-0">
                <a
                  href={href(file.slug)}
                  aria-current={file.slug === current ? 'page' : undefined}
                  class:list={[
                    'block min-h-11 py-3 pr-4 text-[16px] no-underline [overflow-wrap:anywhere]',
                    file.slug === current
                      ? 'bg-red font-bold text-white'
                      : 'font-medium hover:bg-red-tint',
                  ]}
                  style={`padding-left: ${16 + (group.folder ? group.depth + 1 : 0) * 14}px`}
                >
                  {file.name}
                </a>
              </li>
            ))}
          </ul>
        )}
      </li>
    ))}
  </ul>
</aside>
