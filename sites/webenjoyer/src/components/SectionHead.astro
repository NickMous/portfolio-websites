---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="mb-8 flex flex-wrap items-baseline justify-between gap-4 max-sm:mb-6 max-sm:gap-2">
  <h2 class="type-h2">{title}</h2>
  <p class="max-w-[420px] text-[16px] leading-normal max-sm:text-[15px]">
    <slot />
  </p>
</div>
