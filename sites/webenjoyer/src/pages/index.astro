---
import HeroHeadline from '@portfolio/ui-kit/components/HeroHeadline.astro';
import Poster from '@portfolio/ui-kit/components/Poster.astro';
import { getCollection } from 'astro:content';
import ComingSoon from '../components/ComingSoon.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { locale, t } from '../i18n';
import { badgeStatus, displayHost, groupProjects } from '../lib/projects';

const hero = t('hero');
const sections = t('sections');
const { nowShowing, comingSoon } = groupProjects(await getCollection('projects'));

/** Poster facts: the tagline left, the live domain right. */
const facts = (p: (typeof nowShowing)[number]) =>
  [p.data.tagline?.[locale], p.data.url && displayHost(p.data.url)].filter(
    (f): f is string => !!f,
  ) as [string, string] | [string];

// Sections still to come: #21 (open source, early work) and #22 (footer).
---

<SiteLayout>
  <section id="top" class="container-page pt-6 pb-16 max-sm:pt-5 max-sm:pb-12">
    <HeroHeadline
      lines={[
        { text: hero('surfing') },
        { text: hero('theWebComma'), color: 'red' },
        { text: hero('creating'), block: 'yellow' },
        { text: hero('theWebPeriod') },
      ]}
    />
    <div class="mt-12 flex flex-wrap items-start gap-8 max-sm:mt-8 max-sm:gap-6">
      <p class="max-w-[560px] flex-[1_1_380px] type-intro max-sm:text-[17px] max-sm:leading-[1.55]">
        {hero('intro')}
      </p>
      <p class="flex-[0_1_280px] border-t-3 border-ink pt-3 text-[15px] leading-normal max-sm:pt-2.5 max-sm:text-[14px]">
        {hero('note')}
      </p>
    </div>
  </section>

  <section id="work" class="bg-blue py-[72px] pb-[88px] text-white max-sm:pt-12 max-sm:pb-14">
    <div class="container-page">
      <h2 class="mb-10 type-h2 max-sm:mb-7">{sections('nowShowing')}</h2>
      <div class="flex flex-wrap gap-7 max-sm:flex-col max-sm:gap-6">
        {nowShowing.map((p) => {
          const status = badgeStatus(p.data.status);
          const image = p.data.screenshots[0];
          return (
            <Poster
              title={p.data.posterTitle ?? p.data.title}
              color={p.data.posterColor}
              href={`/work/${p.id}/`}
              {...(status ? { status } : {})}
              {...(image ? { image, imageAlt: p.data.title } : {})}
              facts={facts(p)}
              class="flex-[1_1_320px]"
            />
          );
        })}
      </div>
      {comingSoon.map((p) => (
        <div class="mt-14 max-sm:mt-8">
          <ComingSoon project={p} />
        </div>
      ))}
    </div>
  </section>
</SiteLayout>
