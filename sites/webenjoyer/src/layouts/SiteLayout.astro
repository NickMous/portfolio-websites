---
import BaseLayout from '@portfolio/ui-kit/layouts/BaseLayout.astro';
import { t } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const meta = t('meta');
const nav = t('nav');
const { title = meta('title'), description = meta('description'), ogImage } = Astro.props;

// Section anchors live on the homepage; from other pages they lead back there.
const home = Astro.url.pathname === '/' ? '' : '/';
const links = [
  { href: `${home}#work`, label: nav('work') },
  { href: `${home}#opensource`, label: nav('openSource') },
  { href: `${home}#school`, label: nav('schoolStuff') },
  { href: '#hi', label: nav('sayHi') },
];
---

<BaseLayout site="webenjoyer" {title} {description} {...(ogImage ? { ogImage } : {})} nav={links}>
  <slot />
</BaseLayout>
