---
import { contactEmail } from '@portfolio/ui-kit';
import SiteFooter from '@portfolio/ui-kit/components/SiteFooter.astro';
import BaseLayout from '@portfolio/ui-kit/layouts/BaseLayout.astro';
import { kvkNumber } from '../data/business';
import { t } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const meta = t('meta');
const nav = t('nav');
const footer = t('footer');
const { title = meta('title'), description = meta('description'), ogImage } = Astro.props;

// Section anchors live on the homepage; from other pages they lead back there.
const home = Astro.url.pathname === '/' ? '' : '/';
const links = [
  { href: `${home}#work`, label: nav('work') },
  { href: `${home}#opensource`, label: nav('openSource') },
  { href: `${home}#school`, label: nav('schoolStuff') },
  { href: '#hi', label: nav('sayHi') },
];
---

<BaseLayout site="webenjoyer" {title} {description} {...(ogImage ? { ogImage } : {})} nav={links}>
  <slot />
  <SiteFooter site="webenjoyer" id="hi" slot="footer">
    <a slot="cta" href={`mailto:${contactEmail}`}>
      {footer('sayHi')}
    </a>
    <span slot="note">WebEnjoyer · Woerden · KVK {kvkNumber}</span>
  </SiteFooter>
</BaseLayout>
