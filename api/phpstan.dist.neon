parameters:
    level: max
    # bin/ and public/ are Symfony's untouched front controllers.
    paths:
        - config/
        - src/
        - tests/
    excludePaths:
        # Generated by Symfony from the installed bundles' config trees.
        - config/reference.php
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
    doctrine:
        objectManagerLoader: tests/object-manager.php
    ignoreErrors:
        # SwitchGame::$lastPlayed is null only on a new, unsaved admin form;
        # Assert\NotNull keeps null out of the database.
        -
            identifier: doctrine.columnType
            path: src/Entity/SwitchGame.php
