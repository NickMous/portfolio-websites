---
import type { SiteKey } from '../sites';

interface Props {
  site: SiteKey;
}

const { site } = Astro.props;
---

<meta name="umami-site" content={site} />
<script>
  import { loadUmami, umamiConfig } from '../analytics';
  import type { SiteKey } from '../sites';

  const site = document.querySelector<HTMLMetaElement>('meta[name="umami-site"]')?.content;
  if (site) loadUmami(document, location.hostname, umamiConfig(site as SiteKey));
</script>
