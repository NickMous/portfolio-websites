---
import { sharedT } from '../i18n';
import { getLocale } from '../locale';
import { otherSites, siteUrl, sites, type SiteKey } from '../sites';

interface Props {
  site: SiteKey;
  /** Anchor target, e.g. "hi" for a "Say hi" nav link. */
  id?: string;
}

const { site, id } = Astro.props;
const locale = getLocale();
const ui = sharedT('ui');
const color = sites[site].footer;
const onDark = color !== 'yellow';
const bg = { yellow: 'bg-yellow', blue: 'bg-blue', red: 'bg-red', green: 'bg-green' }[color];
const hasCta = Astro.slots.has('cta');
---

<footer
  {id}
  class:list={[bg, onDark ? 'text-white' : 'text-ink', hasCta ? 'pt-18 pb-10' : 'pt-12 pb-8']}
>
  <div class="container-page flex flex-col gap-10 max-sm:gap-8">
    {hasCta && (
      <div class="type-cta [&_a]:no-underline [&_a]:hover:underline">
        <slot name="cta" />
      </div>
    )}

    <div
      class:list={[
        'flex flex-wrap items-center justify-between gap-x-4 gap-y-3 text-[15px] font-medium max-sm:flex-col max-sm:flex-nowrap max-sm:items-start max-sm:text-[14px]',
        hasCta && 'border-t-3 border-current pt-5 max-sm:pt-4',
      ]}
    >
      <div class="max-sm:order-2 [&_a]:font-bold [&_a]:underline">
        <slot name="note" />
      </div>
      <nav aria-label={ui('otherSites')} class="max-sm:order-1">
        <ul class="flex flex-wrap gap-x-5 max-sm:gap-x-4">
          <slot name="links">
            {otherSites(site).map((other) => (
              <li>
                <a href={siteUrl(other, locale)} class="inline-block py-[10px] underline">
                  {sites[other].name} ↗
                </a>
              </li>
            ))}
          </slot>
        </ul>
      </nav>
    </div>
  </div>
</footer>
